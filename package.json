{
  "name": "launch-state-engine",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Local launch state engine for WeChat Mini Program launches: applicable flow, dependencies, evidence and human-confirmed state, shared by a dashboard and an agent-neutral CLI.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "launch-state": "./scripts/launch-state.cli.ts"
  },
  "scripts": {
    "dev": "vinext dev --port 5173",
    "build": "vinext build",
    "start": "vinext start",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "fixtures": "node --experimental-strip-types scripts/run-fixtures.ts",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "launch-state": "node --experimental-strip-types scripts/launch-state.cli.ts",
    "lse": "node --experimental-strip-types scripts/launch-state.cli.ts"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
