next-env.d.ts
*.tsbuildinfo

# build output and local tool state
/dist/
/.wrangler/

# Launch Truth is per-user runtime state, never published:
/public/flows/
# Written by older LSE versions; no longer read.
/public/evidence/

# Internal audit material; not part of the public project documentation.
/PRODUCT_TECHNICAL_PORTFOLIO.md
